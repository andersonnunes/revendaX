@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <div class="user-profile">
            <span class="user-greeting">Olá,</span>
            <span class="user-email">@context.User.Identity?.Name</span>
            <button class="btn secondary sm" @onclick="@(() => Navigation.NavigateToLogout("authentication/logout"))">Sair</button>
        </div>
    </Authorized>
    <NotAuthorized>
        <a class="btn primary sm" href="authentication/login">Entrar</a>
    </NotAuthorized>
</AuthorizeView>
