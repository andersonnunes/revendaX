@page "/painel-vendedor"
@attribute [Authorize(Roles = "vendedor")]
@using System.Globalization
@using System.Net
@using Frontend.Models
@using VendasApi.Domain.Validation
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Painel do Vendedor — RevendaX</PageTitle>

<main class="main-content">
    <h2>Painel do vendedor</h2>

    <div class="auth-tabs" style="max-width: 480px;">
        <button class="auth-tab @(aba == Aba.Cadastrar ? "active" : "")" @onclick="() => MudarAba(Aba.Cadastrar)">
            Cadastrar
        </button>
        <button class="auth-tab @(aba == Aba.Disponiveis ? "active" : "")" @onclick="() => MudarAba(Aba.Disponiveis)">
            Disponíveis
        </button>
        <button class="auth-tab @(aba == Aba.Vendidos ? "active" : "")" @onclick="() => MudarAba(Aba.Vendidos)">
            Vendidos
        </button>
    </div>

    @if (erroGeral is not null)
    {
        <div class="toast error" style="margin: 18px 0; min-width: 0; width: 100%; max-width: 480px;">
            <span class="toast-message">@erroGeral</span>
        </div>
    }

    @if (aba == Aba.Cadastrar)
    {
        <div class="glass-card" style="max-width: 480px; margin-top: 18px;">
            <h3>@(editando is null ? "Cadastrar veículo" : $"Editando {editando.Marca} {editando.Modelo}")</h3>

            <div class="input-group">
                <label for="marca">Marca</label>
                <input id="marca" @bind="marca" @bind:event="oninput" disabled="@salvando" />
                <div class="field-error">@erroMarca</div>
            </div>
            <div class="input-group">
                <label for="modelo">Modelo</label>
                <input id="modelo" @bind="modelo" @bind:event="oninput" disabled="@salvando" />
                <div class="field-error">@erroModelo</div>
            </div>
            <div class="input-group">
                <label for="ano">Ano</label>
                <input id="ano" type="number" @bind="ano" @bind:event="oninput" disabled="@salvando" />
                <div class="field-error">@erroAno</div>
            </div>
            <div class="input-group">
                <label for="cor">Cor</label>
                <input id="cor" @bind="cor" @bind:event="oninput" disabled="@salvando" />
                <div class="field-error">@erroCor</div>
            </div>
            <div class="input-group">
                <label for="preco">Preço</label>
                <input id="preco" type="number" step="0.01" @bind="preco" @bind:event="oninput" disabled="@salvando" />
                <div class="field-error">@erroPreco</div>
            </div>

            @if (editando is null)
            {
                // Placa é imutável na edição (US2.2) — o campo nem aparece quando editando,
                // não é só desabilitado, pra deixar claro que não é enviado no PUT.
                <div class="input-group">
                    <label for="placa">Placa</label>
                    <input id="placa" @bind="placa" @bind:event="oninput" placeholder="ABC1D23" disabled="@salvando" />
                    <div class="field-error">@erroPlaca</div>
                </div>
            }

            <button class="btn primary block" @onclick="SalvarAsync" disabled="@salvando">
                @(salvando ? "Salvando…" : editando is null ? "Cadastrar" : "Salvar edição")
            </button>

            @if (editando is not null)
            {
                <button class="btn secondary block" style="margin-top: 8px;" @onclick="CancelarEdicao" disabled="@salvando">
                    Cancelar edição
                </button>
            }
        </div>
    }
    else if (aba == Aba.Disponiveis)
    {
        @if (carregandoDisponiveis)
        {
            <p class="list-placeholder">Carregando…</p>
        }
        else if (disponiveis.Count == 0)
        {
            <p class="empty-state">Nenhum veículo disponível.</p>
        }
        else
        {
            <div class="vehicle-grid">
                @foreach (var veiculo in disponiveis)
                {
                    <div class="glass-card vehicle-card">
                        <span class="status-badge disponivel">@veiculo.Status</span>
                        <h3>@veiculo.Marca @veiculo.Modelo</h3>
                        <div class="specs">
                            <span>@veiculo.Ano</span>
                            <span>&middot;</span>
                            <span>@veiculo.Cor</span>
                            <span>&middot;</span>
                            <span>@veiculo.Placa</span>
                        </div>
                        <span class="price">@veiculo.Preco.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</span>
                        <div style="display: flex; gap: 8px; margin-top: 8px;">
                            <button class="btn secondary sm" @onclick="() => IniciarEdicao(veiculo)" disabled="@salvando">
                                Editar
                            </button>
                            @if (excluindoId == veiculo.Id)
                            {
                                <button class="btn danger sm" @onclick="() => ExcluirAsync(veiculo)" disabled="@salvando">
                                    Confirmar exclusão?
                                </button>
                            }
                            else
                            {
                                <button class="btn danger sm" @onclick="() => excluindoId = veiculo.Id" disabled="@salvando">
                                    Excluir
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        @if (carregandoVendidos)
        {
            <p class="list-placeholder">Carregando…</p>
        }
        else if (vendidos.Count == 0)
        {
            <p class="empty-state">Nenhum veículo vendido ainda.</p>
        }
        else
        {
            <div class="vehicle-grid">
                @foreach (var veiculo in vendidos)
                {
                    <div class="glass-card vehicle-card">
                        <span class="status-badge vendido">@veiculo.Status</span>
                        <h3>@veiculo.Marca @veiculo.Modelo</h3>
                        <div class="specs">
                            <span>@veiculo.Ano</span>
                            <span>&middot;</span>
                            <span>@veiculo.Cor</span>
                        </div>
                        <span class="price">@veiculo.Preco.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</span>
                    </div>
                }
            </div>
        }
    }
</main>

@code {
    private enum Aba { Cadastrar, Disponiveis, Vendidos }

    private Aba aba = Aba.Cadastrar;

    private List<VeiculoDto> disponiveis = [];
    private List<VeiculoDto> vendidos = [];
    private bool carregandoDisponiveis = true;
    private bool carregandoVendidos = true;

    private VeiculoDto? editando;
    private string marca = string.Empty;
    private string modelo = string.Empty;
    private int ano;
    private string cor = string.Empty;
    private decimal preco;
    private string placa = string.Empty;

    private string? erroMarca;
    private string? erroModelo;
    private string? erroAno;
    private string? erroCor;
    private string? erroPreco;
    private string? erroPlaca;
    private string? erroGeral;

    private bool salvando;
    private Guid? excluindoId;

    // "Meus veículos disponíveis" usa o mesmo GET /veiculos público da vitrine (US4.3) — o
    // backend não modela "dono" de veículo (US2.1 não grava quem cadastrou), então não existe
    // (nem faria sentido existir) uma versão "só meus" desta listagem.
    private HttpClient GatewayPublico => HttpClientFactory.CreateClient("GatewayPublico");

    // Cadastro/edição/exclusão e a listagem de vendidos exigem role vendedor (US2.1/US2.2/
    // US2.4/US2.5) — sempre o client autenticado.
    private HttpClient Gateway => HttpClientFactory.CreateClient("Gateway");

    protected override Task OnInitializedAsync() =>
        Task.WhenAll(CarregarDisponiveisAsync(), CarregarVendidosAsync());

    private void MudarAba(Aba novaAba)
    {
        aba = novaAba;
        erroGeral = null;
    }

    private async Task CarregarDisponiveisAsync()
    {
        carregandoDisponiveis = true;
        try
        {
            disponiveis = await GatewayPublico.GetFromJsonAsync<List<VeiculoDto>>("vendas/veiculos") ?? [];
        }
        catch (HttpRequestException)
        {
            erroGeral = "Não foi possível carregar os veículos disponíveis.";
        }
        finally
        {
            carregandoDisponiveis = false;
        }
    }

    private async Task CarregarVendidosAsync()
    {
        carregandoVendidos = true;
        try
        {
            vendidos = await Gateway.GetFromJsonAsync<List<VeiculoDto>>("vendas/veiculos/vendidos") ?? [];
        }
        catch (HttpRequestException)
        {
            erroGeral = "Não foi possível carregar os veículos vendidos.";
        }
        finally
        {
            carregandoVendidos = false;
        }
    }

    private void IniciarEdicao(VeiculoDto veiculo)
    {
        editando = veiculo;
        marca = veiculo.Marca;
        modelo = veiculo.Modelo;
        ano = veiculo.Ano;
        cor = veiculo.Cor;
        preco = veiculo.Preco;
        LimparErrosDeCampo();
        aba = Aba.Cadastrar;
    }

    private void CancelarEdicao()
    {
        editando = null;
        LimparFormulario();
    }

    private void LimparFormulario()
    {
        marca = modelo = cor = placa = string.Empty;
        ano = 0;
        preco = 0;
        LimparErrosDeCampo();
    }

    private void LimparErrosDeCampo()
    {
        erroMarca = erroModelo = erroAno = erroCor = erroPreco = erroPlaca = null;
    }

    private bool Validar()
    {
        var anoMaximo = DateTimeOffset.UtcNow.Year + 1;

        erroMarca = string.IsNullOrWhiteSpace(marca) ? "Informe a marca." : null;
        erroModelo = string.IsNullOrWhiteSpace(modelo) ? "Informe o modelo." : null;
        // Mesmo intervalo de Veiculo.Cadastrar/AtualizarDados (VendasApi.Domain) — replicado
        // como constante simples, não via referência de projeto: são duas condições, não um
        // algoritmo (diferente do PlacaValidator, que é lógica de verdade).
        erroAno = ano is < 1950 ? "Ano deve ser 1950 ou posterior."
            : ano > anoMaximo ? $"Ano não pode passar de {anoMaximo}."
            : null;
        erroCor = string.IsNullOrWhiteSpace(cor) ? "Informe a cor." : null;
        erroPreco = preco <= 0 ? "Preço deve ser maior que zero." : null;

        if (editando is null)
        {
            var placaNormalizada = PlacaValidator.Normalizar(placa);
            erroPlaca = PlacaValidator.IsValid(placaNormalizada) ? null : "Placa inválida.";
        }

        return erroMarca is null && erroModelo is null && erroAno is null && erroCor is null
            && erroPreco is null && erroPlaca is null;
    }

    private async Task SalvarAsync()
    {
        erroGeral = null;
        if (!Validar())
        {
            return;
        }

        salvando = true;
        try
        {
            var resposta = editando is null
                ? await Gateway.PostAsJsonAsync("vendas/veiculos", new
                {
                    marca,
                    modelo,
                    ano,
                    cor,
                    preco,
                    placa = PlacaValidator.Normalizar(placa),
                })
                : await Gateway.PutAsJsonAsync($"vendas/veiculos/{editando.Id}", new { marca, modelo, ano, cor, preco });

            if (resposta.IsSuccessStatusCode)
            {
                editando = null;
                LimparFormulario();
                await CarregarDisponiveisAsync();
                aba = Aba.Disponiveis;
                return;
            }

            erroGeral = resposta.StatusCode switch
            {
                HttpStatusCode.Conflict when editando is null => "Já existe um veículo com essa placa.",
                HttpStatusCode.Conflict => "Este veículo foi vendido e não pode mais ser editado.",
                HttpStatusCode.NotFound => "Este veículo não existe mais.",
                HttpStatusCode.UnprocessableEntity => "Dados inválidos — confira ano, preço e placa.",
                _ => "Não foi possível salvar. Tente novamente.",
            };
        }
        catch (HttpRequestException)
        {
            erroGeral = "Não foi possível conectar ao servidor. Tente novamente.";
        }
        finally
        {
            salvando = false;
        }
    }

    private async Task ExcluirAsync(VeiculoDto veiculo)
    {
        erroGeral = null;
        salvando = true;
        try
        {
            var resposta = await Gateway.DeleteAsync($"vendas/veiculos/{veiculo.Id}");

            if (resposta.StatusCode is HttpStatusCode.NoContent)
            {
                disponiveis.Remove(veiculo);
            }
            else if (resposta.StatusCode == HttpStatusCode.Conflict)
            {
                // Veículo deixou de estar Disponivel entre o carregamento da lista e o clique
                // (ex.: outro cliente comprou nesse meio-tempo) — recarrega pra refletir a
                // realidade, em vez de deixar um card de exclusão impossível na tela.
                erroGeral = $"{veiculo.Marca} {veiculo.Modelo} não pode mais ser excluído (não está mais disponível).";
                await CarregarDisponiveisAsync();
            }
            else if (resposta.StatusCode != HttpStatusCode.NotFound)
            {
                erroGeral = "Não foi possível excluir. Tente novamente.";
            }
        }
        catch (HttpRequestException)
        {
            erroGeral = "Não foi possível conectar ao servidor. Tente novamente.";
        }
        finally
        {
            excluindoId = null;
            salvando = false;
        }
    }
}
